# Copie ce fichier en `.env.local` si tu veux pointer vers un autre projet Supabase.
# Sans ces variables, l'app utilise le projet Supabase de Lashly (valeurs publiques).
# Ne mets jamais de clé secrète dans Git.

# Supabase : Project Settings > API Keys (clé « publishable », pas la secrète)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
