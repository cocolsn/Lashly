# Copie ce fichier en `.env.local` et remplis les valeurs.
# Ne mets jamais le fichier `.env.local` dans Git.

# Supabase : Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète, uniquement côté serveur (jamais dans le navigateur)
SUPABASE_SERVICE_ROLE_KEY=

# Resend (emails, étape 7)
RESEND_API_KEY=

# URL publique du site (sans / final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
